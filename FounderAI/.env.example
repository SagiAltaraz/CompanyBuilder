# Required — get from https://platform.openai.com
OPENAI_API_KEY=sk-...

# The values below are auto-set by docker-compose when running via `make up`.
# Override only if you run the backend locally against your own services.
POSTGRES_URL=postgresql://founderai:founderai_secret@postgres:5432/founderai
REDIS_URL=redis://redis:6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
CHROMA_HOST=chromadb
CHROMA_PORT=8000
